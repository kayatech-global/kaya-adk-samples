# Copy to .env in this folder (it is git-ignored) and fill in the keys below.
# `adk run`, `adk web`, `adk api_server` and the FastAPI server all read this file; a variable already set in your shell wins.

# --- Required: the Gemini key ------------------------------------------------------------------------------------------
# Every model step runs on Gemini 3.8 Flash through ADK's own Gemini class (Google AI Studio key: aistudio.google.com/apikey).
# When it is overloaded or down (HTTP 429, 500, 502, 503 or 504) a call moves on to Gemini 3.5 Flash, with the same key.
# To use Vertex AI instead, set GOOGLE_GENAI_USE_ENTERPRISE=true, GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION.
# Retrieve country risk context calls the public World Bank agent over A2A and needs no key.
GOOGLE_API_KEY=

# --- Optional: OpenAI as the last fallback --------------------------------------------------------------------------------
# With a key, a call both Gemini models fail moves on to OpenAI gpt-5.5; without one it is left out.
# Either variable works; MODEL_GPT_5_5_API_KEY is the named secret (docs/how-to/bind-secrets.md).
# OPENAI_API_KEY=
# MODEL_GPT_5_5_API_KEY=

# --- Optional: the `arc` profile of runtime.yaml (README, "Extending for ARC"). Its providers are placeholders until implemented.
# FLOW_PROVIDER_MODE=arc

# --- Optional: settings of this agent (docs/reference/settings.md). Every one has a default. ------------------------------
# FLOW_PROFILE=development          # production: fail closed, require real identity providers and named secrets
# FLOW_SESSION_URI=memory://        # e.g. sqlite+aiosqlite:///runs.db so paused runs survive a restart (run host)
# FLOW_DEFAULT_MODEL=               # replaces the model of steps that had none in Kaya, e.g. openai/gpt-4o
